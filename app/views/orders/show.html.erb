<div class="max-w-2xl mx-auto bg-white shadow-md rounded-lg p-8 mt-10">
  <h1 class="text-2xl font-bold mb-6 text-gray-800">Order Details</h1>
  <div class="mb-4">
    <span class="font-semibold text-gray-700">Order Number:</span>
    <span class="ml-2 text-gray-900"><%= @order.id %></span>
  </div>
  <div class="mb-4">
    <span class="font-semibold text-gray-700">Order Date:</span>
    <span class="ml-2 text-gray-900"><%= @order.created_at.strftime("%B %d, %Y") %></span>
  </div>
  <div class="mb-4">
    <span class="font-semibold text-gray-700">Status:</span>
    <% status_classes = {
                  'unpaid'    => 'bg-red-100 text-red-800',
                  'paid'      => 'bg-blue-100 text-blue-800',
                  'cancelled' => 'bg-gray-200 text-gray-600',
                  'completed' => 'bg-green-100 text-green-800'
                } %>
    <span class="inline-block px-2 py-1 text-xs font-semibold rounded-full <%= status_classes[@order.status] || 'bg-gray-100 text-gray-800' %>">
      <%= @order.status.titleize %>
    </span>
  </div>
  <div class="mb-4">
    <%= link_to "View Payment Detail", order_payments_path(@order), class: "text-blue-600 hover:underline font-medium" %>
  </div>
  <h2 class="text-xl font-semibold mb-4 text-gray-800">Items</h2>
  <table class="min-w-full mb-6">
    <thead>
      <tr>
        <th class="text-left py-2 px-4 text-gray-600">Product</th>
        <th class="text-left py-2 px-4 text-gray-600">Quantity</th>
        <th class="text-left py-2 px-4 text-gray-600">Price</th>
        <th class="text-left py-2 px-4 text-gray-600">Total</th>
      </tr>
    </thead>
    <tbody>
      <%# @order.order_items.each => N+1 query so we use includes %>
      <% order_items_w_products = @order.order_items.includes(:product) %>
      <% @order.order_items.each do |item| %>
        <tr class="border-t">
          <td class="py-2 px-4">
            <%= link_to item.product.name, product_path(item.product), class: "text-blue-600 hover:underline" %>
          </td>
          <td class="py-2 px-4"><%= item.quantity %></td>
          <td class="py-2 px-4"><%= number_to_currency(item.price) %></td>
          <td class="py-2 px-4"><%= number_to_currency(item.price * item.quantity) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="flex justify-end">
    <div class="text-lg font-bold text-gray-800">
      Total: <%= number_to_currency(@order.total_price) %>
    </div>
  </div>
</div>

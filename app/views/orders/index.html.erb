<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= search_form_for @q, url: orders_path, method: :get, html: { class: 'flex flex-wrap gap-4 items-end' } do |f| %>
      <div>
        <%= f.label :status_eq, 'Status', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.select :status_eq, OrderStatus.keys.map { |s| [s.titleize, s] }, { include_blank: 'All' }, class: 'mt-1 block w-full rounded border-gray-300 shadow-sm' %>
      </div>
      <div>
        <%= f.label :created_at_gteq, 'From Date', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.date_field :created_at_gteq, class: 'mt-1 block w-full rounded border-gray-300 shadow-sm' %>
      </div>
      <div>
        <%= f.label :created_at_lteq, 'To Date', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.date_field :created_at_lteq, class: 'mt-1 block w-full rounded border-gray-300 shadow-sm' %>
      </div>
      <div class="w-32">
        <%= f.label :total_price_gteq, 'Min Total', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.number_field :total_price_gteq, class: 'mt-1 block w-full rounded border-gray-300 shadow-sm text-sm py-1' %>
      </div>
      <div class="w-32">
        <%= f.label :total_price_lteq, 'Max Total', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.number_field :total_price_lteq, class: 'mt-1 block w-full rounded border-gray-300 shadow-sm text-sm py-1' %>
      </div>
      <div>
        <%= f.submit 'Filter', class: 'inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition' %>
      </div>
      <div>
        <%= link_to 'Reset', orders_path, class: 'inline-block px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400 transition' %>
      </div>
    <% end %>
  </div>
  <h1 class="text-3xl font-bold text-blue-700 mb-6">My Orders</h1>
  <% if @orders.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white shadow rounded-lg">
        <thead>
          <tr>
            <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Order #</th>
            <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Total</th>
            <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-50"></th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="hover:bg-gray-100">
              <td class="px-6 py-4 border-b border-gray-200">
                <%= order.id %>
              </td>
              <td class="px-6 py-4 border-b border-gray-200"><%= order.created_at.strftime("%Y-%m-%d") %></td>
              <td class="px-6 py-4 border-b border-gray-200">
                <% status_classes = {
                  'unpaid'    => 'bg-red-100 text-red-800',
                  'paid'      => 'bg-blue-100 text-blue-800',
                  'cancelled' => 'bg-gray-200 text-gray-600',
                  'completed' => 'bg-green-100 text-green-800'
                } %>
                <span class="inline-block px-2 py-1 text-xs font-semibold rounded-full <%= status_classes[order.status] || 'bg-gray-100 text-gray-800' %>">
                  <%= order.status.titleize %>
                </span>
              </td>
              <td class="px-6 py-4 border-b border-gray-200"><%= number_to_currency(order.total_price) %></td>
              <td class="px-6 py-4 border-b border-gray-200 text-right flex flex-row gap-2 justify-end">
                <%= link_to 'View', order_path(order), class: "inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" %>
                <% if order.status == 'unpaid' %>
                  <%= link_to 'Go to Payment', new_with_order_payments_path(order_id: order.id), class: "inline-block px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition" %>
                  <%= button_to 'Cancel Order', cancel_order_path(order), method: :post, data: { turbo: false, confirm: 'Are you sure you want to cancel this order?' }, class: "inline-block px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition cursor-pointer" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="mt-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="bg-blue-100 border border-blue-300 rounded-lg px-6 py-4 text-blue-900 font-semibold shadow">
          Total Outcome: <span class="font-bold">$<%= number_to_currency(@total_outcome, unit: '', precision: 2) %></span>
        </div>
        <div class="w-full md:w-auto flex justify-end">
          <%= paginate @orders, theme: 'tailwind', params: request.query_parameters %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="bg-yellow-100 text-yellow-800 px-4 py-3 rounded">
      You have no orders yet.
    </div>
  <% end %>
</div>
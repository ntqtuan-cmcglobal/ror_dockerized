<main class="flex-1 container mx-auto px-4 py-16 flex flex-col items-center">
  <section class="text-center mb-16">
    <h2 class="text-5xl font-extrabold text-gray-900 mb-6">Discover, Buy, and Sell Digital Assets</h2>
    <p class="text-xl text-gray-600 mb-8">Marketplace for high-quality digital products: graphics, templates, code, and more.</p>
    <a href="/products" class="bg-blue-600 text-white px-8 py-4 rounded-lg shadow-lg hover:bg-blue-700 transition text-lg font-semibold">Browse Products</a>
  </section>
  <section class="w-full">
    <h3 class="text-2xl font-bold text-gray-800 mb-8 text-center">Featured Products</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <% @products.each do |product| %>
        <% show_draft = (current_user&.admin? || current_user&.seller?) %>
        <% is_draft = product.is_draft? %>
        <% next if is_draft && current_user&.buyer? %>
        <% if policy(product).show? %>
          <% is_bought = current_user&.orders&.joins(:order_items)&.where(order_items: { product_id: product.id }, status: 'paid')&.exists? %>
          <% is_owned = is_bought || product.user_id == current_user&.id %>
          <div class="group relative bg-gradient-to-br from-white to-gray-50 rounded-xl shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 overflow-hidden border border-gray-100
            <%= 'ring-2 ring-yellow-400 ring-offset-2' if is_draft && show_draft %>
            <%= 'ring-2 ring-emerald-400 ring-offset-2' if is_owned %>">
            <!-- Status Badges -->
            <% if is_draft && show_draft %>
              <div class="absolute top-3 left-3 z-10 px-3 py-1 bg-yellow-400 text-yellow-900 text-xs font-bold rounded-full shadow-lg">
                DRAFT
              </div>
            <% end %>
            <% if is_owned %>
              <div class="absolute top-3 right-3 z-10 px-3 py-1 bg-emerald-500 text-white text-xs font-bold rounded-full shadow-lg">
                OWNED
              </div>
            <% end %>
            <!-- Product Image with Overlay -->
            <div class="relative overflow-hidden">
              <% if product.digital_asset.attached? %>
                <% if product.digital_asset.image? %>
                  <% image_variant = product.digital_asset.variant(resize_to_limit: [400, 280]) rescue nil %>
                  <%= image_tag url_for(image_variant ? image_variant.processed : product.digital_asset), class: "object-cover w-full h-56 group-hover:scale-110 transition-transform duration-300" %>
                <% elsif product.digital_asset.video? %>
                  <% video_thumb = product.video_thumbnail %>
                  <% video_variant = video_thumb&.variant(resize_to_limit: [400, 280]) rescue nil %>
                  <%= image_tag url_for(video_variant ? video_variant.processed : video_thumb), class: "object-cover w-full h-56 group-hover:scale-110 transition-transform duration-300" %>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="bg-black bg-opacity-50 rounded-full p-3">
                      <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M8 5v10l8-5z"/>
                      </svg>
                    </div>
                  </div>
                <% elsif product.digital_asset.audio? %>
                  <div class="flex items-center justify-center h-56 bg-gray-200">
                    <%= image_tag "/music-placeholder.png", class: "object-cover w-full h-full" %>
                  </div>
                <% else %>
                  <div class="flex items-center justify-center h-56 bg-gradient-to-br from-gray-100 to-gray-200">
                    <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                <% end %>
              <% else %>
                <div class="flex items-center justify-center h-56 bg-gradient-to-br from-gray-100 to-gray-200">
                  <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% end %>
              <!-- Category Badge -->
              <div class="absolute bottom-3 left-3">
                <span class="inline-block px-2 py-1 bg-white bg-opacity-90 text-gray-700 text-xs font-medium rounded-md shadow-sm">
                  <%= product.category ? product.category.name : "Uncategorized" %>
                </span>
              </div>
            </div>
            <!-- Product Info -->
            <div class="p-6">
              <!-- Title and Rating -->
              <div class="flex items-start justify-between mb-3">
                <h2 class="text-lg font-bold text-gray-900 line-clamp-2 flex-1 mr-2">
                  <%= product.name %>
                </h2>
                <% if product.average_rating.present? && product.average_rating > 0 %>
                  <div class="flex items-center gap-1 bg-yellow-50 px-2 py-1 rounded-lg">
                    <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.966a1 1 0 00.95.69h4.175c.969 0 1.371 1.24.588 1.81l-3.38 2.455a1 1 0 00-.364 1.118l1.287 3.966c.3.921-.755 1.688-1.54 1.118l-3.38-2.455a1 1 0 00-1.175 0l-3.38 2.455c-.784.57-1.838-.197-1.539-1.118l1.287-3.966a1 1 0 00-.364-1.118L2.049 9.393c-.783-.57-.38-1.81.588-1.81h4.175a1 1 0 00.95-.69l1.286-3.966z" />
                    </svg>
                    <span class="text-yellow-600 font-semibold text-sm"><%= sprintf('%.1f', product.average_rating) %></span>
                  </div>
                <% end %>
              </div>
              <!-- Description -->
              <% desc = product.description.to_s %>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                <%= desc.length > 16 ? "#{desc[0,24]}..." : desc %>
              </p>
              <!-- Price and Seller -->
              <div class="flex items-center justify-between mb-4">
                <div class="text-2xl font-bold text-blue-600"><%= number_to_currency(product.price) %></div>
                <div class="text-xs text-gray-500">by <%= product.user.full_name %></div>
              </div>
              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-2">
                <%= link_to 'View', product, class: "flex-1 text-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors" if policy(product).show? %>
              </div>
              <!-- Buyer Actions -->
              <% if current_user&.buyer? %>
                <div class="mt-3">
                  <% in_cart = current_user.cart.cart_items.exists?(product_id: product.id) %>
                  <% if is_owned %>
                    <button class="w-full px-4 py-2 bg-emerald-100 text-emerald-700 font-medium rounded-lg cursor-not-allowed flex items-center justify-center gap-2">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      Already Owned
                    </button>
                  <% else %>
                    <%= button_to add_item_cart_path(product_id: product.id), method: :post, class: "w-full px-4 py-2 font-medium rounded-lg transition-colors flex items-center justify-center gap-2 #{in_cart ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'cursor-pointer bg-emerald-600 text-white hover:bg-emerald-700'}", disabled: in_cart do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.293 2.293A1 1 0 004 16h9M7 13v6a2 2 0 002 2h4a2 2 0 002-2v-6"/>
                      </svg>
                      <%= in_cart ? 'In Cart' : 'Add to Cart' %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
  <section class="w-full mt-16">
    <h3 class="text-2xl font-bold text-gray-800 mb-8 text-center">Why Choose Our Marketplace?</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-lg shadow p-6 flex flex-col items-center">
        <svg class="w-12 h-12 text-blue-600 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M12 8v4l3 3"></path>
          <circle cx="12" cy="12" r="10"></circle>
        </svg>
        <h4 class="text-lg font-semibold mb-2">Fast & Secure Transactions</h4>
        <p class="text-gray-600 text-center">Buy and sell digital assets with confidence using our secure payment system.</p>
      </div>
      <div class="bg-white rounded-lg shadow p-6 flex flex-col items-center">
        <svg class="w-12 h-12 text-green-600 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M5 13l4 4L19 7"></path>
          <circle cx="12" cy="12" r="10"></circle>
        </svg>
        <h4 class="text-lg font-semibold mb-2">Quality Products</h4>
        <p class="text-gray-600 text-center">All products are reviewed to ensure top quality and originality.</p>
      </div>
      <div class="bg-white rounded-lg shadow p-6 flex flex-col items-center">
        <svg class="w-12 h-12 text-yellow-600 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M12 17v-5l-4-4"></path>
          <circle cx="12" cy="12" r="10"></circle>
        </svg>
        <h4 class="text-lg font-semibold mb-2">Supportive Community</h4>
        <p class="text-gray-600 text-center">Join a vibrant community of creators and buyers, and get support when you need it.</p>
      </div>
    </div>
  </section>
  <section class="w-full mt-16">
    <h3 class="text-2xl font-bold text-gray-800 mb-8 text-center">How It Works</h3>
    <div class="flex flex-col md:flex-row justify-center items-stretch gap-8">
      <div class="bg-white rounded-lg shadow p-6 flex-1">
        <h4 class="text-lg font-semibold mb-2">1. Sign Up</h4>
        <p class="text-gray-600">Create your free account to start buying or selling digital assets.</p>
      </div>
      <div class="bg-white rounded-lg shadow p-6 flex-1">
        <h4 class="text-lg font-semibold mb-2">2. Browse & Purchase</h4>
        <p class="text-gray-600">Explore our marketplace and purchase products that fit your needs.</p>
      </div>
      <div class="bg-white rounded-lg shadow p-6 flex-1">
        <h4 class="text-lg font-semibold mb-2">3. Download & Enjoy</h4>
        <p class="text-gray-600">Instantly download your purchased assets and start using them right away.</p>
      </div>
    </div>
  </section>
  <section class="w-full mt-16">
    <h3 class="text-2xl font-bold text-gray-800 mb-8 text-center">Content for Creators & Buyers</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-white rounded-lg shadow p-6">
        <h4 class="text-lg font-semibold mb-2">For Creators (Sellers)</h4>
        <p class="text-gray-600">Upload your digital products, set your price, and reach a global audience. Our platform provides tools to manage your listings and track your sales easily.</p>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h4 class="text-lg font-semibold mb-2">For Buyers</h4>
        <p class="text-gray-600">Discover a wide range of high-quality digital assets. Enjoy secure payments, instant downloads, and dedicated support for all your purchases.</p>
      </div>
    </div>
  </section>
</main>

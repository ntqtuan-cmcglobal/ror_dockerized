<!-- Page Header -->
<div class="mb-8">
  <h1 class="text-3xl font-bold text-blue-700">Products</h1>
  <p class="text-blue-500 mt-1">Browse and filter products below.</p>
</div>
<!-- Products Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
  <!-- Filters -->
  <div class="col-span-full mb-6">
    <div class="bg-white rounded-lg shadow p-6 flex flex-wrap gap-6 items-end">
      <%= form_with url: products_path, method: :get, local: true, class: "flex flex-wrap gap-6 items-end w-full" do |f| %>
        <div class="flex flex-col w-48">
          <%= f.label :search, "🔍 Search", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :search, value: params[:search], placeholder: "Product name...", class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
        </div>
        <div class="flex flex-col w-40">
          <%= f.label :category_id, "🗂️ Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :category_id, Category.all, :id, :name, { include_blank: "All" }, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
        </div>
        <div class="flex flex-col w-32">
          <%= f.label :min_price, "Min Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :min_price, value: params[:min_price], min: 0, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
        </div>
        <div class="flex flex-col w-32">
          <%= f.label :max_price, "Max Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :max_price, value: params[:max_price], min: 0, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
        </div>
        <div>
          <%= f.submit "Filter", class: "inline-flex items-center px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
  <% if current_user&.admin? || current_user&.seller? %>
    <div class="col-span-full mb-4 flex justify-start">
      <%= link_to 'Add Product', new_product_path, class: "inline-flex items-center px-5 py-2 bg-green-600 text-white font-semibold rounded-lg shadow hover:bg-green-700 transition cursor-pointer" %>
    </div>
  <% end %>
  <% @products.each do |product| %>
    <% if policy(product).show? %>
      <div class="bg-white rounded-lg shadow hover:shadow-lg transition overflow-hidden flex flex-col">
        <img src="<%= product.url || '/no-products-found.png' %>" class="w-full h-48 object-contain object-center rounded-t-lg" alt="<%= product.name %>" loading="lazy" />
        <div class="p-4 flex-1 flex flex-col">
          <h2 class="text-lg font-semibold mb-1"><%= product.name %></h2>
          <p class="text-gray-600 text-sm mb-2 line-clamp-2"><%= product.description %></p>
          <div class="flex items-center justify-between mt-auto">
            <span class="text-blue-600 font-bold"><%= number_to_currency(product.price) %></span>
            <span class="text-xs text-gray-500"><%= product.category ? product.category.name : "Uncategorized" %></span>
          </div>
          <div class="mt-2 flex gap-2">
            <%= link_to 'Show', product, class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800 hover:bg-blue-200" if policy(product).show? %>
            <%= link_to 'Edit', edit_product_path(product), class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-yellow-100 text-yellow-800 hover:bg-yellow-200" if policy(product).edit? %>
            <%= link_to 'Destroy', product, method: :delete, data: { confirm: 'Are you sure?' }, class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-red-100 text-red-800 hover:bg-red-200" if policy(product).destroy? %>
            <% if current_user&.buyer? %>
              <% in_cart = current_user.cart.cart_items.exists?(product_id: product.id) %>
              <%= button_to 'Add to Cart', add_item_cart_path(product_id: product.id), method: :post, class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded #{in_cart ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-green-100 text-green-800 hover:bg-green-200 cursor-pointer'}", disabled: in_cart %>
            <% end %>
          </div>
        </div>
        <div class="px-4 pb-4 text-xs text-gray-400">
          Seller: <%= product.user.full_name %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

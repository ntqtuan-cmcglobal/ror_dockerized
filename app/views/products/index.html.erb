<!-- Page Header -->
<div class="mb-8">
  <h1 class="text-3xl font-bold text-blue-700">Products</h1>
  <p class="text-blue-500 mt-1">Browse and filter products below.</p>
</div>
<!-- Products Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
  <!-- Filters -->
  <div class="col-span-full mb-6">
    <div class="bg-white rounded-lg shadow p-6 flex flex-wrap gap-6 items-end">
      <%= search_form_for @q, class: "flex flex-wrap gap-6 items-end w-full" do |f| %>
        <div class="flex flex-col w-48">
          <%= f.label :name_cont, "🔍 Search", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.search_field :name_cont, placeholder: "Product name...", class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
        </div>
        <div class="flex flex-col w-40">
          <%= f.label :category_id_eq, "🗂️ Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :category_id_eq, Category.all, :id, :name, { include_blank: "All" }, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
        </div>
        <div class="flex flex-col w-32">
          <%= f.label :price_gteq, "💰 Min Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :price_gteq, value: params.dig(:q, :price_gteq), min: 0, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
        </div>
        <div class="flex flex-col w-32">
          <%= f.label :price_lteq, "💸 Max Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :price_lteq, value: params.dig(:q, :price_lteq), min: 0, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
        </div>
        <div>
          <%= f.submit "Filter", class: "inline-flex items-center px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition cursor-pointer" %>
        </div>
        <div>
          <%= link_to "Reset", products_path, class: "inline-flex items-center px-5 py-2 bg-gray-200 text-gray-700 font-semibold rounded-lg shadow hover:bg-gray-300 transition cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
  <% if current_user&.admin? || current_user&.seller? %>
    <div class="col-span-full mb-4 flex items-center justify-start gap-4">
      <%= link_to 'Add Product', new_product_path, class: "inline-flex items-center px-5 py-2 bg-green-600 text-white font-semibold rounded-lg shadow hover:bg-green-700 transition cursor-pointer" %>
      <%= link_to 'Bulk Import', bulk_import_products_path, class: "inline-flex items-center px-5 py-2 bg-purple-600 text-white font-semibold rounded-lg shadow hover:bg-purple-700 transition cursor-pointer" %>
    </div>
  <% end %>
  <% if @products.any? %>
    <div class="col-span-full mb-4 flex items-center justify-end">
      <label for="sort-select" class="text-sm text-gray-600 mr-2">Sort by:</label>
      <%= form_with url: products_path, method: :get, local: true, class: "inline-block" do |form| %>
        <% # Preserve existing filters %>
        <% params.fetch(:q, {}).each do |k, v| %>
          <% unless %w[s].include?(k) %>
            <%= hidden_field_tag "q[#{k}]", v %>
          <% end %>
        <% end %>
        <select name="q[s]" id="sort-select" class="rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2 bg-blue-50 text-blue-700">
          <option value="created_at desc" <%= (params.dig(:q, :s).blank? || params.dig(:q, :s) == 'created_at desc') ? 'selected' : '' %>>Created Date (Newest)</option>
          <option value="created_at asc" <%= 'selected' if params.dig(:q, :s) == 'created_at asc' %>>Created Date (Oldest)</option>
          <option value="name asc" <%= 'selected' if params.dig(:q, :s) == 'name asc' %>>Name (A-Z)</option>
          <option value="name desc" <%= 'selected' if params.dig(:q, :s) == 'name desc' %>>Name (Z-A)</option>
          <option value="price asc" <%= 'selected' if params.dig(:q, :s) == 'price asc' %>>Price (Low to High)</option>
          <option value="price desc" <%= 'selected' if params.dig(:q, :s) == 'price desc' %>>Price (High to Low)</option>
      </select>
      <%= form.submit "Sort", class: "ml-2 px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition cursor-pointer" %>
      <% end %>
    </div>
            <% @products.each do |product| %>
              <% show_draft = (current_user&.admin? || current_user&.seller?) %>
              <% is_draft = product.is_draft? %>
              <% have_error = product.error_message != nil %>
              <% next if (is_draft || have_error) && current_user&.buyer? %>
              <% if policy(product).show? %>
                <% is_bought = current_user&.orders&.joins(:order_items)&.where(order_items: { product_id: product.id }, status: 'paid')&.exists? %>
                <% is_owned = is_bought || product.user_id == current_user&.id %>
                <div class="bg-white rounded-lg shadow hover:shadow-lg transition overflow-hidden flex flex-col
        <%= 'border-4 border-yellow-400' if is_draft && show_draft %>
        <%= ' ring-4 ring-green-400' if is_owned %>">
                  <% if is_draft && show_draft %>
                    <div class="px-4 py-2 bg-yellow-100 text-yellow-800 text-xs font-bold">
                      DRAFT PRODUCT
                    </div>
                  <% end %>
                  <% if is_owned %>
                    <div class="px-4 py-2 bg-green-100 text-green-800 text-xs font-bold">
                      OWNED
                    </div>
                  <% end %>
                  <% if product.error_message? %>
                    <div class="flex items-center px-4 py-2 bg-red-100 text-red-800 text-xs font-bold" title="<%= product.error_message %>">
                      <svg class="w-5 h-5 mr-2 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="white"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01" stroke="currentColor" stroke-width="2"/>
                      </svg>
                      Upload Error
                    </div>
                  <% end %>
                  <% if product.digital_asset.attached? %>
                    <% if product.digital_asset.image? %>
                      <% if product.digital_asset.variant(resize_to_limit: [300, 300]) %>
                        <%= image_tag url_for(product.digital_asset.variant(resize_to_limit: [300, 300]).processed), class: "object-cover w-full h-48" %>
                      <% else %>
                        <%= image_tag "/no-products-found.png", size: "300x300", class: "object-cover w-full h-48" %>
                      <% end %>
                    <% elsif product.digital_asset.video? %>
                      <% if product.video_thumbnail && product.video_thumbnail.variant(resize_to_limit: [300, 300]) %>
                        <%= image_tag url_for(product.video_thumbnail.variant(resize_to_limit: [300, 300]).processed), class: "object-cover w-full h-48" %>
                      <% else %>
                        <div class="flex items-center justify-center w-full h-48 bg-gray-200">
                          <%= image_tag "/no-products-found.png", class: "object-contain w-full h-full" %>
                        </div>
                      <% end %>
                    <% elsif product.digital_asset.audio? %>
                      <div class="flex items-center justify-center h-48 bg-gray-200">
                        <%= image_tag "/music-placeholder.png", class: "object-cover w-full h-full" %>
                      </div>
                    <% else %>
                      <%= image_tag "/no-products-found.png", size: "300x300", class: "object-cover w-full h-48" %>
                    <% end %>
                  <% else %>
                    <%= image_tag "/no-products-found.png", size: "300x300", class: "object-cover w-full h-48" %>
                  <% end %>
                  <div class="p-4 flex-1 flex flex-col">
                    <h2 class="text-lg font-semibold mb-1 flex items-center gap-2">
                      <%= product.name %>
                      <% if product.average_rating.present? && product.average_rating > 0 %>
                        <span class="flex items-center gap-1">
                          <svg class="w-4 h-4 text-yellow-400 inline-block" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.966a1 1 0 00.95.69h4.175c.969 0 1.371 1.24.588 1.81l-3.38 2.455a1 1 0 00-.364 1.118l1.287 3.966c.3.921-.755 1.688-1.54 1.118l-3.38-2.455a1 1 0 00-1.175 0l-3.38 2.455c-.784.57-1.838-.197-1.539-1.118l1.287-3.966a1 1 0 00-.364-1.118L2.049 9.393c-.783-.57-.38-1.81.588-1.81h4.175a1 1 0 00.95-.69l1.286-3.966z" />
                          </svg>
                          <span class="text-yellow-500 font-semibold text-sm"><%= sprintf('%.1f', product.average_rating) %></span>
                        </span>
                      <% end %>
                    </h2>
                    <p class="text-gray-600 text-sm mb-2 line-clamp-2"><%= product.description %></p>
                    <div class="flex items-center justify-between mt-auto">
                      <span class="text-blue-600 font-bold"><%= number_to_currency(product.price) %></span>
                      <span class="text-xs text-gray-500"><%= product.category ? product.category.name : "Uncategorized" %></span>
                    </div>
                    <div class="mt-2 flex gap-2">
                      <%= link_to 'Show', product, class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800 hover:bg-blue-200" if policy(product).show? %>
                      <%= link_to 'Edit', edit_product_path(product), class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-yellow-100 text-yellow-800 hover:bg-yellow-200" if policy(product).edit? %>
                      <%= link_to 'Destroy', product, method: :delete, data: { confirm: 'Are you sure?' }, class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-red-100 text-red-800 hover:bg-red-200" if policy(product).destroy? %>
                      <% if current_user&.buyer? %>
                        <% in_cart = current_user.cart.cart_items.exists?(product_id: product.id) %>
                        <% if is_owned %>
                          <span class="inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-green-200 text-green-700 cursor-not-allowed">Owned</span>
                        <% else %>
                          <%= button_to 'Add to Cart', add_item_cart_path(product_id: product.id), method: :post, class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded #{in_cart ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-green-100 text-green-800 hover:bg-green-200 cursor-pointer'}", disabled: in_cart %>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                  <div class="px-4 pb-4 text-xs text-gray-400">
                    Seller: <%= product.user.full_name %>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div class="col-span-full">
              <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-5 rounded-lg flex items-center justify-center shadow">
                <svg class="w-6 h-6 mr-2 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M12 20a8 8 0 100-16 8 8 0 000 16z"/>
                </svg>
                <span class="font-medium">No products found.</span>
              </div>
            </div>
          <% end %>
          <div class="col-span-full mb-4">
            <%= paginate @products, theme: 'tailwind' %>
          </div>
        </div>

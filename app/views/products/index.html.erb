<h1 class="text-3xl text-blue-600 font-bold mb-6">Products</h1>
<% if policy(Product).new? %>
  <div class="mb-6">
    <%= link_to 'New Product', new_product_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none" %>
  </div>
<% end %>
<!-- Filters -->
<div class="mb-6 flex flex-wrap gap-4 items-end">
  <%= form_with url: products_path, method: :get, local: true, class: "flex flex-wrap gap-4" do |f| %>
    <div>
      <%= f.label :search, "Search", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :search, value: params[:search], class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :category_id, "Category", class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :category_id, Category.all, :id, :name, { include_blank: "All" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :min_price, "Min Price", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :min_price, value: params[:min_price], min: 0, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :max_price, "Max Price", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :max_price, value: params[:max_price], min: 0, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :sort, "Sort By", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :sort, [["Newest", "newest"], ["Price: Low to High", "price_asc"], ["Price: High to Low", "price_desc"]], { include_blank: "Default" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.submit "Filter", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none" %>
    </div>
  <% end %>
</div>
<!-- Products Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
  <% @products.each do |product| %>
    <% if policy(product).show? %>
      <div class="bg-white rounded-lg shadow hover:shadow-lg transition overflow-hidden flex flex-col">
        <img src="<%= product.url || '/no-products-found.png' %>" class="w-full h-48 object-contain object-center rounded-t-lg" alt="<%= product.name %>" loading="lazy" />
        <div class="p-4 flex-1 flex flex-col">
          <h2 class="text-lg font-semibold mb-1"><%= product.name %></h2>
          <p class="text-gray-600 text-sm mb-2 line-clamp-2"><%= product.description %></p>
          <div class="flex items-center justify-between mt-auto">
            <span class="text-blue-600 font-bold"><%= number_to_currency(product.price) %></span>
            <span class="text-xs text-gray-500"><%= product.category ? product.category.name : "Uncategorized" %></span>
          </div>
          <div class="mt-2 flex gap-2">
            <%= link_to 'Show', product, class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800 hover:bg-blue-200" if policy(product).show? %>
            <%= link_to 'Edit', edit_product_path(product), class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-yellow-100 text-yellow-800 hover:bg-yellow-200" if policy(product).edit? %>
            <%= link_to 'Destroy', product, method: :delete, data: { confirm: 'Are you sure?' }, class: "inline-flex items-center px-2 py-1 text-xs font-semibold rounded bg-red-100 text-red-800 hover:bg-red-200" if policy(product).destroy? %>
          </div>
        </div>
        <div class="px-4 pb-4 text-xs text-gray-400">
          Seller: <%= product.user.full_name %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
<h1>Products</h1>
<table class="table table-striped table-bordered">
  <thead class="thead-dark">
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Price</th>
      <th>Seller</th>
      <th>Category</th>
      <th colspan="3">Action</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <% if policy(product).show? %>
        <tr>
          <td><%= product.name %></td>
          <td><%= product.description %></td>
          <td><%= number_to_currency(product.price) %></td>
          <td><%= product.user.full_name %></td>
          <td><%= product.category ? product.category.name : "Uncategorized" %></td>
          <td>
            <%= link_to 'Show', product, class: "btn btn-info btn-sm" if policy(product).show? %>
            <%= link_to 'Edit', edit_product_path(product), class: "btn btn-warning btn-sm" if policy(product).edit? %>
            <%= link_to 'Destroy', product, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger btn-sm" if policy(product).destroy? %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<br>
<% if policy(Product).new? %>
  <%= link_to 'New Product', new_product_path, class: "btn btn-primary" %>
<% end %>
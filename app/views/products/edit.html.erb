<%= form_with(model: @product, local: true, html: { class: "max-w-2xl mx-auto py-8" }) do |form| %>
  <div class="bg-white shadow-lg rounded-lg overflow-hidden">
    <div class="bg-blue-600 px-6 py-4">
      <h2 class="text-white text-2xl font-semibold">Edit Product</h2>
    </div>
    <div class="px-6 py-6">
      <% if @product.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
          <h5 class="font-bold mb-2">Please fix the following errors:</h5>
          <ul class="list-disc list-inside">
            <% @product.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="mb-5">
        <%= form.label :name, class: "block text-gray-700 font-bold mb-2" %>
        <%= form.text_field :name, class: "w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "Enter product name" %>
      </div>
      <div class="mb-5">
        <%= form.label :description, class: "block text-gray-700 font-bold mb-2" %>
        <%= form.text_area :description, class: "w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400", rows: 4, placeholder: "Enter product description" %>
      </div>
      <div class="mb-5">
        <%= form.label :price, class: "block text-gray-700 font-bold mb-2" %>
        <%= form.number_field :price, step: 0.01, class: "w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400", placeholder: "Enter price" %>
      </div>
      <div class="mb-5">
        <%= form.label :is_draft, "Draft?", class: "block text-gray-700 font-bold mb-2" %>
        <%= form.hidden_field :is_draft, value: false %>
        <%= form.check_box :is_draft, {}, true, false %>
      </div>
      <div class="mb-5">
        <%= form.label :category, class: "block text-gray-700 font-bold mb-2" %>
        <%= form.select :category_id, options_for_select(@categories.map { |c| [c.name, c.id] }, @product.category&.id), { include_blank: "Select category" }, class: "w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>
      <%= form.label :digital_asset, "Digital Asset", class: "block text-gray-700 font-bold mb-2" %>
      <div class="mb-5">
        <% if @product.digital_asset.attached? %>
          <div class="mb-2 flex items-center space-x-2">
            <span class="text-gray-600 text-sm">Current file:</span>
            <%= link_to @product.digital_asset.filename.to_s, url_for(@product.digital_asset), target: "_blank", class: "text-blue-600 underline hover:text-blue-800 transition hover:cursor-pointer" %>
          </div>
        <% end %>
        <%= form.file_field :digital_asset, class: "block w-full text-sm text-gray-700 border rounded-lg border-gray-300 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400 py-2 px-4 hover:cursor-pointer" %>
      </div>
      <div class="flex items-center space-x-4">
        <%= form.submit "Update Product", class: "bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-2 rounded-lg transition" %>
        <%= link_to "Back", products_path, class: "bg-white border border-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-100 transition" %>
      </div>
    </div>
  <% end %>

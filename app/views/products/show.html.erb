<div class="max-w-3xl mx-auto mt-10">
  <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
    <div class="px-8 py-6 bg-gradient-to-r from-blue-700 to-blue-500 rounded-t-2xl">
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Product Details</h1>
    </div>
    <div class="px-8 py-6">
      <% if @product.digital_asset.attached? %>
        <div class="mb-6 flex justify-center">
          <% content_type = @product.digital_asset.content_type %>
          <% if content_type.start_with?('video/') %>
            <div class="w-full max-w-2xl aspect-video rounded-xl shadow-lg overflow-hidden bg-black flex items-center justify-center">
              <%= video_tag url_for(@product.digital_asset), controls: true, class: "w-full h-full object-contain", controlsList: "nodownload" do %>
                Your browser does not support the video tag.
              <% end %>
            </div>
          <% elsif content_type.start_with?('image/') %>
            <div class="w-full max-w-2xl aspect-video rounded-xl shadow-lg overflow-hidden bg-gray-100 flex items-center justify-center">
              <%= link_to url_for(@product.digital_asset), target: "_blank", rel: "noopener" do %>
                <%= image_tag url_for(@product.digital_asset), class: "w-full h-full object-contain" %>
              <% end %>
            </div>
          <% elsif content_type.start_with?('audio/') %>
            <div class="w-full max-w-md rounded-xl shadow-lg overflow-hidden bg-blue-50 flex items-center justify-center py-6">
              <%= audio_tag url_for(@product.digital_asset), controls: true, class: "w-full mb-2" do %>
                Your browser does not support the audio tag.
              <% end %>
            </div>
          <% else %>
            <div class="w-full max-w-md rounded-xl shadow-lg overflow-hidden bg-gray-50 flex items-center justify-center py-6">
              <span class="text-gray-500 italic">Unsupported file type.</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="mb-6 flex justify-center">
          <img src="<%= '/no-products-found.png' %>" alt="Product Image" class="max-h-72 rounded-xl shadow-lg object-contain bg-gray-100" />
        </div>
      <% end %>
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 mb-6">
        <div>
          <dt class="font-semibold text-gray-600">Name</dt>
          <dd class="text-lg text-gray-900"><%= @product.name %></dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-600">Seller</dt>
          <dd class="text-lg text-gray-900"><%= @product.user.full_name %></dd>
        </div>
        <div class="md:col-span-2">
          <dt class="font-semibold text-gray-600">Description</dt>
          <dd class="text-gray-800"><%= @product.description %></dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-600">Price</dt>
          <dd class="text-lg text-green-700 font-bold"><%= number_to_currency(@product.price) %></dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-600">Category</dt>
          <dd class="text-lg text-gray-900"><%= @product.category ? @product.category.name : "Uncategorized" %></dd>
        </div>
      </dl>
      <div class="flex flex-wrap gap-3 mt-4">
        <% if current_user&.buyer? %>
          <% in_cart = current_user.cart.cart_items.exists?(product_id: @product.id) %>
          <%= button_to 'Add to Cart', add_item_cart_path(product_id: @product.id), method: :post, class: "px-5 py-2 rounded-lg font-semibold transition #{in_cart ? 'bg-gray-300 text-gray-500 cursor-not-allowed opacity-60' : 'bg-green-600 text-white hover:bg-green-700'}", disabled: in_cart %>
        <% end %>
        <%= link_to 'Back to Homepage', root_path, class: "px-5 py-2 rounded-lg bg-blue-100 text-blue-700 font-semibold hover:bg-blue-200 transition" %>
        <%= link_to 'Back to Products', products_path, class: "px-5 py-2 rounded-lg bg-blue-100 text-blue-700 font-semibold hover:bg-blue-200 transition" %>
      </div>
    </div>
  </div>
  <div class="bg-white shadow-xl rounded-2xl mt-10 overflow-hidden">
    <div class="px-8 py-5 border-b border-gray-100 bg-gray-50">
      <h2 class="text-2xl font-bold text-gray-800">Reviews</h2>
    </div>
    <div class="px-8 py-6 space-y-6">
      <div class="border-b border-gray-100 pb-3">
        <div class="flex items-center mb-1">
          <span class="font-semibold text-gray-700">Jane Doe</span>
          <span class="ml-3 text-sm text-gray-400">2 days ago</span>
        </div>
        <p class="text-gray-800">Great product! Highly recommended.</p>
      </div>
      <div class="border-b border-gray-100 pb-3">
        <div class="flex items-center mb-1">
          <span class="font-semibold text-gray-700">John Smith</span>
          <span class="ml-3 text-sm text-gray-400">5 days ago</span>
        </div>
        <p class="text-gray-800">Good value for the price.</p>
      </div>
    </div>
    <div class="px-8 py-5 border-t border-gray-100 bg-gray-50">
      <h3 class="text-lg font-semibold text-gray-700 mb-2">Leave a Review</h3>
      <div class="text-gray-500 italic">
        Review functionality coming soon.
      </div>
    </div>
  </div>
</div>
<div class="max-w-3xl mx-auto mt-10">
  <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
    <div class="px-8 py-6 bg-gradient-to-r from-blue-700 to-blue-500 rounded-t-2xl flex items-center justify-between">
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Product Details</h1>
      <div class="flex items-center justify-end flex-1">
        <% if @product.is_draft? %>
          <span class="inline-block px-3 py-1 rounded-full bg-yellow-400 text-yellow-900 font-semibold text-sm ml-4">Draft</span>
        <% end %>
        <% if @product.have_error? %>
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-red-400 text-red-900 font-semibold text-sm ml-4 cursor-pointer group">
            Error
            <span class="hidden group-hover:inline absolute z-10 mt-8 ml-2 px-3 py-2 rounded bg-white border border-gray-200 text-sm text-gray-700 shadow-lg">
              <%= @product.error_message %>
            </span>
          </span>
        <% end %>
      </div>
    </div>
    <div class="px-8 py-6">
      <% if @product.digital_asset_demo.attached? %>
        <div class="mb-6 flex justify-center">
          <% content_type = @product.digital_asset_demo.content_type %>
          <% if content_type.start_with?('video/') %>
            <div class="w-full max-w-2xl aspect-video rounded-xl shadow-lg overflow-hidden bg-black flex items-center justify-center">
              <%= video_tag url_for(@product.digital_asset_demo), controls: true, class: "w-full h-full object-contain", controlsList: "nodownload" do %>
                Your browser does not support the video tag.
              <% end %>
            </div>
          <% elsif content_type.start_with?('image/') %>
            <div class="w-full max-w-2xl aspect-video rounded-xl shadow-lg overflow-hidden bg-gray-100 flex items-center justify-center">
              <%= link_to url_for(@product.digital_asset_demo), target: "_blank", rel: "noopener" do %>
                <%= image_tag url_for(@product.digital_asset_demo), class: "w-full h-full object-contain" %>
              <% end %>
            </div>
          <% elsif content_type.start_with?('audio/') %>
            <div class="w-full max-w-md rounded-xl shadow-lg overflow-hidden bg-blue-50 flex items-center justify-center py-6">
              <%= audio_tag url_for(@product.digital_asset_demo), controls: true, class: "w-full mb-2" do %>
                Your browser does not support the audio tag.
              <% end %>
            </div>
          <% else %>
            <div class="w-full max-w-md rounded-xl shadow-lg overflow-hidden bg-gray-50 flex items-center justify-center py-6">
              <span class="text-gray-500 italic">Unsupported file type.</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="mb-6 flex justify-center">
          <img src="<%= '/no-products-found.png' %>" alt="Product Image" class="max-h-72 rounded-xl shadow-lg object-contain bg-gray-100" />
        </div>
      <% end %>
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 mb-6">
        <div>
          <dt class="font-semibold text-gray-600">Name</dt>
          <dd class="text-lg text-gray-900"><%= @product.name %></dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-600">Seller</dt>
          <dd class="text-lg text-gray-900"><%= @product.user.full_name %></dd>
        </div>
        <div class="md:col-span-2">
          <dt class="font-semibold text-gray-600">Description</dt>
          <dd class="text-gray-800"><%= @product.description %></dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-600">Price</dt>
          <dd class="text-lg text-green-700 font-bold"><%= number_to_currency(@product.price) %></dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-600">Category</dt>
          <dd class="text-lg text-gray-900"><%= @product.category ? @product.category.name : "Uncategorized" %></dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-600">Average Rating</dt>
          <dd class="flex items-center text-lg font-bold">
            <% if @product.average_rating.present? && @product.average_rating.to_f > 0 %>
              <% avg = @product.average_rating.to_f %>
              <% 1.upto(5) do |star| %>
                <svg class="w-6 h-6 mr-1 <%= avg >= star ? 'text-yellow-400' : (avg >= star - 0.5 ? 'text-yellow-300' : 'text-gray-300') %>" fill="<%= avg >= star ? '#FBBF24' : (avg >= star - 0.5 ? '#FDE68A' : 'none') %>" stroke="currentColor" viewBox="0 0 24 24">
                  <polygon stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="12 17.27 18.18 21 16.54 13.97 22 9.24 14.81 8.63 12 2 9.19 8.63 2 9.24 7.46 13.97 5.82 21 12 17.27"/>
                </svg>
              <% end %>
              <span class="ml-2 text-yellow-500"><%= number_with_precision(avg, precision: 1) %> / 5</span>
            <% else %>
              <span class="text-gray-400 italic">No ratings yet</span>
            <% end %>
          </dd>
        </div>
      </dl>
      <div class="flex flex-wrap gap-3 mt-4">
        <% if current_user&.buyer? %>
          <% in_cart = current_user.cart.cart_items.exists?(product_id: @product.id) %>
          <%= button_to 'Add to Cart', add_item_cart_path(product_id: @product.id), method: :post, class: "px-5 py-2 rounded-lg font-semibold transition #{in_cart ? 'bg-gray-300 text-gray-500 cursor-not-allowed opacity-60' : 'bg-green-600 text-white hover:bg-green-700 cursor-pointer'}", disabled: in_cart %>
          <% if policy(@product).download? %>
            <%= link_to 'Premium download', download_product_path(@product), class: "px-5 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition" %>
          <% else %>
            <span class="px-5 py-2 rounded-lg bg-gray-200 text-gray-600 font-semibold cursor-not-allowed">Buy to access premium download</span>
          <% end %>
        <% end %>
        <% if policy(@product).edit? %>
          <%= link_to 'Edit Product', edit_product_path(@product), class: "px-5 py-2 rounded-lg bg-yellow-500 text-white font-semibold hover:bg-yellow-600 transition" %>
        <% end %>
        <%= link_to 'Back to Homepage', root_path, class: "px-5 py-2 rounded-lg bg-blue-100 text-blue-700 font-semibold hover:bg-blue-200 transition" %>
        <%= link_to 'Back to Products', products_path, class: "px-5 py-2 rounded-lg bg-blue-100 text-blue-700 font-semibold hover:bg-blue-200 transition" %>
      </div>
    </div>
  </div>
  <div class="bg-white shadow-xl rounded-2xl mt-10 overflow-hidden">
    <div class="px-8 py-5 border-b border-gray-100 bg-gray-50">
      <h2 class="text-2xl font-bold text-gray-800">Reviews</h2>
    </div>
    <div class="px-8 py-6 space-y-6">
      <% if flash[:review_error].present? %>
        <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-700 font-semibold">
          <%= flash[:review_error] %>
        </div>
      <% end %>
      <% if @product.reviews.empty? %>
        <div class="text-gray-500 italic">No reviews yet.</div>
      <% else %>
        <% @product.reviews.order(created_at: :desc).each do |review| %>
          <div class="border-b border-gray-100 pb-3">
            <div class="flex items-center mb-1">
              <span class="font-semibold text-gray-700"><%= review.user == current_user ? "You" : review.user.full_name %></span>
              <div class="ml-2 flex items-center gap-1">
                <% 1.upto(5) do |star| %>
                  <svg class="w-5 h-5 <%= review.rating >= star ? 'text-yellow-400' : 'text-gray-300' %>" fill="<%= review.rating >= star ? '#FBBF24' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                    <polygon stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="12 17.27 18.18 21 16.54 13.97 22 9.24 14.81 8.63 12 2 9.19 8.63 2 9.24 7.46 13.97 5.82 21 12 17.27"/>
                  </svg>
                <% end %>
              </div>
              <span class="ml-auto text-sm text-gray-500">
                <span class="ml-3 text-sm text-gray-400"><%= time_ago_in_words(review.created_at) %> ago</span>
              </span>
            </div>
            <p class="text-gray-800"><%= review.comment %></p>
          </div>
        <% end %>
      <% end %>
    </div>
    <div class="px-8 py-5 border-t border-gray-100 bg-gray-50">
      <h3 class="text-lg font-semibold text-gray-700 mb-2">
        <% if @review && @review.persisted? %>
          Edit Your Review
        <% else %>
          Leave a Review
        <% end %>
      </h3>
      <% if user_signed_in? %>
        <% review_form = @review || @product.reviews.find_by(user_id: current_user.id) || @product.reviews.build %>
        <%= form_with(model: review_form, url: save_review_product_path(@product), local: true, method: :post) do |f| %>
          <% if review_form.errors.any? %>
            <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-700 font-semibold">
              <ul class="list-disc pl-5">
                <% review_form.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div class="mb-3">
            <label class="block font-semibold text-gray-700 mb-2">Rating <span class="text-red-500">*</span></label>
            <div class="flex items-center gap-2" id="star-rating">
              <% 1.upto(5) do |star| %>
                <%= f.radio_button :rating, star, id: "review_rating_#{star}", class: "hidden" %>
                <label for="review_rating_<%= star %>" class="cursor-pointer star-label" data-star="<%= star %>">
                  <svg class="w-7 h-7 <%= review_form.rating.to_i >= star ? 'text-yellow-400' : 'text-gray-300' %>" fill="<%= review_form.rating.to_i >= star ? '#FBBF24' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                    <polygon stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="12 17.27 18.18 21 16.54 13.97 22 9.24 14.81 8.63 12 2 9.19 8.63 2 9.24 7.46 13.97 5.82 21 12 17.27"/>
                  </svg>
                </label>
              <% end %>
            </div>
          </div>
          <div class="mb-3">
            <%= f.text_area :comment, rows: 3, class: "w-full rounded-lg border-2 border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-gray-50 p-3 text-gray-900 placeholder-gray-400 transition", placeholder: "Write your review...", required: true %>
          </div>
          <div class="flex gap-4">
            <%= f.submit review_form.persisted? ? "Update Review" : "Submit Review", class: "px-4 py-2 rounded bg-blue-600 text-white font-semibold hover:bg-blue-700 transition cursor-pointer" %>
            <% if review_form.persisted? %>
              <%= link_to 'Delete Review', delete_review_product_path(@product), method: :delete, data: { confirm: 'Are you sure you want to delete your review?' }, class: "px-4 py-2 rounded bg-red-500 text-white font-semibold hover:bg-red-600 transition cursor-pointer" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="text-gray-500 italic">
          Please <%= link_to "sign in", new_user_session_path, class: "text-blue-600 underline" %> to leave a review.
        </div>
      <% end %>
    </div>
  </div>

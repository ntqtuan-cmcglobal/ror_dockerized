<div class="max-w-2xl mx-auto mt-8">
  <div class="bg-white shadow rounded-lg">
    <div class="px-6 py-4 border-b bg-blue-600 rounded-t-lg">
      <h1 class="text-2xl font-bold text-white">Product Details</h1>
    </div>
    <div class="px-6 py-4">
      <div class="mb-4 flex justify-center">
        <img src="<%= @product.url || '/no-products-found.png' %>" alt="Product Image" class="max-h-64 rounded shadow" />
      </div>
      <p class="mb-2">
        <span class="font-semibold text-gray-700">Name:</span>
        <%= @product.name %>
      </p>
      <p class="mb-2">
        <span class="font-semibold text-gray-700">Description:</span>
        <%= @product.description %>
      </p>
      <p class="mb-2">
        <span class="font-semibold text-gray-700">Seller:</span>
        <%= @product.user.full_name %>
      </p>
      <p class="mb-2">
        <span class="font-semibold text-gray-700">Price:</span>
        <%= number_to_currency(@product.price) %>
      </p>
      <p class="mb-4">
        <span class="font-semibold text-gray-700">Category:</span>
        <%= @product.category ? @product.category.name : "Uncategorized" %>
      </p>
      <div class="flex space-x-2">
        <%= link_to 'Back to Homepage', root_path, class: "inline-block px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" %>
        <%= link_to 'Back to Products', products_path, class: "inline-block px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" %>
      </div>
    </div>
  </div>
  <!-- Reviews Section -->
  <div class="bg-white shadow rounded-lg mt-8">
    <div class="px-6 py-4 border-b">
      <h2 class="text-xl font-semibold text-gray-800">Reviews</h2>
    </div>
    <div class="px-6 py-4 space-y-4">
      <div class="border-b pb-2">
        <div class="flex items-center mb-1">
          <span class="font-semibold text-gray-700">Jane Doe</span>
          <span class="ml-2 text-sm text-gray-500">2 days ago</span>
        </div>
        <p class="text-gray-800">Great product! Highly recommended.</p>
      </div>
      <div class="border-b pb-2">
        <div class="flex items-center mb-1">
          <span class="font-semibold text-gray-700">John Smith</span>
          <span class="ml-2 text-sm text-gray-500">5 days ago</span>
        </div>
        <p class="text-gray-800">Good value for the price.</p>
      </div>
    </div>
    <div class="px-6 py-4 border-t">
      <h3 class="text-lg font-semibold text-gray-700 mb-2">Leave a Review</h3>
      <div class="text-gray-500 italic">
        Review functionality coming soon.
      </div>
    </div>
  </div>
</div>
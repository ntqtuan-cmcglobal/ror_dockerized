<%# app/views/categories/new.html.erb %>
<div class="container mx-auto mt-12">
  <div class="flex justify-center">
    <div class="w-full max-w-md">
      <h2 class="mb-6 text-2xl font-bold text-blue-600">New Category</h2>
      <%= form_with(model: @category, local: true) do |form| %>
        <% if @category.errors.any? %>
          <div class="mb-4 rounded bg-red-100 border border-red-400 text-red-700 px-4 py-3">
            <h4 class="font-semibold mb-2">Please fix the following errors:</h4>
            <ul class="list-disc list-inside">
              <% @category.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="mb-4">
          <%= form.label :name, class: "block text-gray-700 font-medium mb-2" %>
          <%= form.text_field :name, class: "block w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500", autofocus: true %>
        </div>
        <div class="flex justify-between">
          <%= form.submit "Create Category", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded" %>
          <%= link_to "Back", categories_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-2 px-4 rounded" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<h1 class="text-3xl font-bold mb-6 text-blue-600">Category: <%= @category.name %></h1>
<% if @category.products.any? %>
  <h2 class="text-xl font-semibold mb-4">Products in this Category:</h2>
  <ul class="space-y-2 mb-6">
    <% @category.products.each do |product| %>
      <li>
        <%= link_to product.name, product_path(product), class: "text-blue-600 hover:underline" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded shadow mb-6">
    No products found in this category.
  </div>
<% end %>
<div class="flex space-x-4">
  <%= link_to 'Edit Category', edit_category_path(@category), class: "bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 px-4 rounded" %>
  <%= link_to 'Back to Categories', categories_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-2 px-4 rounded" %>
</div>

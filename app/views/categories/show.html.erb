<h1 class="text-4xl font-extrabold mb-8 text-blue-700 border-b pb-2">Category: <%= @category.name %></h1>
<% if @products.any? %>
  <h2 class="text-2xl font-bold mb-6 text-blue-600">Products in this Category</h2>
  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <% @products.each do |product| %>
      <li class="bg-white rounded-lg shadow p-4 hover:shadow-lg transition">
        <%= link_to product.name, product_path(product), class: "text-blue-700 font-semibold hover:underline text-lg" %>
      </li>
    <% end %>
  </ul>
  <%= paginate @products, theme: 'tailwind' %>
<% else %>
  <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-lg shadow mb-8 text-center">
    No products found in this category.
  </div>
<% end %>
<div class="flex space-x-4 mt-8">
  <% if policy(@category).edit? %>
    <%= link_to 'Edit Category', edit_category_path(@category), class: "bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 px-6 rounded-lg shadow" %>
  <% end %>
  <%= link_to 'Back to Categories', categories_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-900 font-semibold py-2 px-6 rounded-lg shadow" %>
</div>

<div class="container mx-auto mt-8 px-4">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-blue-600">Categories</h1>
    <% if policy(Category).new? %>
      <%= link_to 'New Category', new_category_path, class: 'bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded shadow' %>
    <% end %>
  </div>
  <% if @categories.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow">
        <thead>
          <tr class="bg-gray-100">
            <th class="py-3 px-6 text-left font-semibold text-gray-700">Name</th>
            <th class="py-3 px-6 text-right font-semibold text-gray-700">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr class="border-t border-gray-200 hover:bg-gray-50">
              <td class="py-3 px-6"><%= category.name %></td>
              <td class="py-3 px-6 text-right space-x-2">
                <% if policy(category).show? %>
                  <%= link_to 'Show', category_path(category), class: 'inline-block bg-blue-100 hover:bg-blue-200 text-blue-700 font-medium py-1 px-3 rounded text-sm' %>
                <% end %>
                <% if policy(category).edit? %>
                  <%= link_to 'Edit', edit_category_path(category), class: 'inline-block bg-yellow-100 hover:bg-yellow-200 text-yellow-800 font-medium py-1 px-3 rounded text-sm' %>
                <% end %>
                <% if policy(category).destroy? %>
                  <%= link_to 'Delete', category_path(category), method: :delete, data: { confirm: 'Are you sure?' }, class: 'inline-block bg-red-100 hover:bg-red-200 text-red-700 font-medium py-1 px-3 rounded text-sm' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded shadow mt-4">
      No categories found.
    </div>
  <% end %>
</div>
<%= paginator.render do -%>
  <nav class="pagination-row flex items-center justify-center space-x-2 m-10" role="navigation" aria-label="pager">
    <%= prev_page_tag unless current_page.first? %>
    <div class="flex items-center justify-center">
      <% each_page do |page| -%>
        <% if page.display_tag? -%>
          <%= page_tag page %>
        <% elsif !page.was_truncated? -%>
          <%= gap_tag %>
        <% end -%>
      <% end -%>
    </div>
    <% unless current_page.out_of_range? %>
      <%= next_page_tag unless current_page.last? %>
    <% end %>
  </nav>
  <form method="get" class="flex justify-center items-center gap-4 mt-6" onsubmit="return this.page.value && !isNaN(this.page.value);">
    <div class="flex items-center gap-2">
      <label for="goto-page" class="text-sm text-gray-700">Go to page:</label>
      <input id="goto-page" name="page" type="number" min="1" max="<%= total_pages %>" class="w-22 px-2 py-1 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" value="<%= current_page.number %>">
      <button type="submit" class="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 transition">Go</button>
    </div>
    <div class="flex items-center gap-2">
      <label for="per-page" class="text-sm text-gray-700">Items per page:</label>
      <select id="per-page" name="per_page" class="px-2 py-1 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="this.form.submit()">
        <% per_page_options = [10, 20, 50, 100] %>
        <% current_per_page = params[:per_page].to_i > 0 ? params[:per_page].to_i : per_page %>
        <% per_page_options.push current_per_page unless per_page_options.include?(current_per_page) %>
        <% per_page_options.uniq.sort.each do |n| %>
          <option value="<%= n %>" <%= 'selected' if current_per_page == n %>><%= n %></option>
          <% end %>
        </select>
      </div>
    </form>
  <% end -%>

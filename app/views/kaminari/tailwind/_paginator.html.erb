<%= paginator.render do -%>
  <nav class="pagination-row flex items-center justify-center space-x-2 m-10" role="navigation" aria-label="pager">
    <%= prev_page_tag unless current_page.first? %>
    <div class="flex items-center justify-center">
      <% each_page do |page| -%>
        <% if page.display_tag? -%>
          <%= page_tag page %>
        <% elsif !page.was_truncated? -%>
          <%= gap_tag %>
        <% end -%>
      <% end -%>
    </div>
    <% unless current_page.out_of_range? %>
      <%= next_page_tag unless current_page.last? %>
    <% end %>
  </nav>
  <form method="get" class="ml-4 flex items-center justify-center m-4" onsubmit="return this.page.value && !isNaN(this.page.value);">
    <label for="goto-page" class="mr-2 text-sm text-gray-700">Go to page:</label>
    <input id="goto-page" name="page" type="number" min="1" max="<%= total_pages %>" class="w-24 px-2 py-1 border rounded" value="<%= current_page.number %>">
    <button type="submit" class="ml-2 px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600">Go</button>
  </form>
<% end -%>

<div class="min-h-screen flex flex-col justify-center items-center bg-gray-50">
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "bg-white rounded-2xl shadow-xl p-10 w-full max-w-sm" }) do |f| %>
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-center text-gray-800 mb-4">Log in to continue</h2>
      <%= f.label :email, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition" %>
    </div>
    <div class="mb-6">
      <%= f.label :password, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="mb-6 flex items-center">
        <%= f.check_box :remember_me, class: "mr-3 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
        <%= f.label :remember_me, class: "text-gray-700 font-medium" %>
      </div>
    <% end %>
    <div class="mb-6">
      <%= f.submit "Login", class: "w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-lg transition" %>
    </div>
    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  <% end %>
</div>

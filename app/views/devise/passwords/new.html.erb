<h2 class="mb-4 text-2xl font-bold text-center text-gray-800">Forgot your password?</h2>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "bg-white p-6 rounded-lg shadow-md mx-auto", style: "max-width: 400px;" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div class="mb-4">
    <%= f.label :email, class: "block text-gray-700 font-medium mb-2" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= f.submit "Send me reset password instructions", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded transition-colors" %>
  </div>
<% end %>
<div class="mt-4 text-center">
  <%= render "devise/shared/links" %>
</div>

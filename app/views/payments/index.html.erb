<% if params[:order_id].present? %>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8 text-gray-800">Payments for Order #<%= params[:order_id] %></h1>
    <% if @payments.any? %>
      <div class="overflow-x-auto rounded-lg shadow-lg bg-white">
        <table class="min-w-full border border-gray-200 rounded-lg">
          <thead class="sticky top-0 z-10 bg-gray-50">
            <tr>
              <th class="px-6 py-3 border-b text-left font-semibold text-gray-700">ID</th>
              <th class="px-6 py-3 border-b text-left font-semibold text-gray-700">Order</th>
              <th class="px-6 py-3 border-b text-left font-semibold text-gray-700">Result</th>
              <th class="px-6 py-3 border-b text-left font-semibold text-gray-700">Payment Method</th>
              <th class="px-6 py-3 border-b text-left font-semibold text-gray-700">Created At</th>
              <th class="px-6 py-3 border-b text-left font-semibold text-gray-700">Stripe Checkout URL</th>
              <th class="px-6 py-3 border-b text-left font-semibold text-gray-700">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @payments.each do |payment| %>
              <tr class="hover:bg-gray-100 transition">
                <td class="px-6 py-4 border-b"><%= payment.id %></td>
                <td class="px-6 py-4 border-b"><%= payment.order_id %></td>
                <td class="px-6 py-4 border-b" style="background-color: <%= PaymentResult.color_for(payment.result) %>; color: white;">
                  <%= payment.result %>
                </td>
                <td class="px-6 py-4 border-b">
                  <%= PaymentMethod.method_name(payment.payment_method) %>
                </td>
                <td class="px-6 py-4 border-b"><%= payment.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
                <td class="px-6 py-4 border-b">
                  <% if payment.stripe_checkout_url.present? %>
                    <a href="<%= payment.stripe_checkout_url %>" target="_blank" class="text-blue-600 hover:underline break-all">
                      Stripe Checkout
                    </a>
                  <% else %>
                    <span class="text-gray-400">N/A</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 border-b">
                  <% if policy(payment).mark_as_paid? %>
                    <%= button_to 'Mark as Paid', mark_as_paid_payments_path(payment), method: :post, class: 'bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition-colors cursor-pointer' %>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="6" class="px-6 py-4">
                  <%= paginate @payments, theme: 'tailwind' %>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
        <% if policy(Order).show? %>
          <div class="mt-6 flex justify-start">
            <%= link_to 'Back to Order Detail', order_path(params[:order_id]), class: 'inline-block px-5 py-2 bg-gray-200 rounded hover:bg-gray-300 font-semibold transition-colors duration-150' %>
          </div>
        <% end %>
      <% else %>
        <p class="text-gray-500 mt-8 text-center">No payments found for this order.</p>
        <% if policy(Order).show? %>
          <div class="mt-6 flex justify-start">
            <%= link_to 'Back to Order Detail', order_path(params[:order_id]), class: 'inline-block px-5 py-2 bg-gray-200 rounded hover:bg-gray-300 font-semibold transition-colors duration-150' %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="max-w-xl mx-auto px-4 py-8">
      <p class="text-red-600 font-semibold text-center">Order ID parameter is required.</p>
    </div>
  <% end %>
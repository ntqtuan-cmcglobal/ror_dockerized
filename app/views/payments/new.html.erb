<div class="max-w-md mx-auto mt-10 bg-white p-8 rounded shadow">
  <h1 class="text-2xl font-bold mb-6 text-blue-600">New Payment</h1>
  <div class="mb-4">
    <span class="block text-gray-700 font-semibold">Order ID:</span>
    <span class="text-gray-900"><%= params[:order_id] %></span>
    <span class="block text-gray-700 font-semibold mt-2">Order Date:</span>
    <span class="text-gray-900"><%= @order&.created_at&.strftime("%B %d, %Y") || "N/A" %></span>
  </div>
  <%= form_with model: @payment, url: payments_path, method: :post, local: true, class: "space-y-6" do |form| %>
    <%= form.hidden_field :order_id, value: params[:order_id] %>
    <div>
      <label class="block text-gray-700 font-semibold mb-2">Payment Method</label>
      <div class="space-y-2">
        <label class="flex items-center">
          <%= form.radio_button :payment_method, 'bank_transfer', checked: true, class: "mr-2 accent-blue-600" %>
          <span class="text-gray-900">Bank Transfer</span>
        </label>
        <label class="flex items-center">
          <%= form.radio_button :payment_method, 'stripe', class: "mr-2 accent-gray-400" %>
          <span>Stripe</span>
        </label>
        <label class="flex items-center text-gray-400 cursor-not-allowed">
          <%= form.radio_button :payment_method, 'paypal', disabled: true, class: "mr-2 accent-gray-400" %>
          <span>PayPal <span class="ml-1 text-xs">(coming soon)</span></span>
        </label>
      </div>
    </div>
    <div>
      <%= form.submit "Submit Payment", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded cursor-pointer", id: "checkout-button" %>
    </div>
  <% end %>
</div>
<% if @payment&.payment_method == 'stripe' %>
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var stripe = Stripe("<%= Rails.configuration.stripe[:publishable_key] %>");
      var checkoutButton = document.getElementById("checkout-button");

      if (checkoutButton) {
        checkoutButton.addEventListener("click", function () {
          fetch("/create-checkout-session", {
            method: "POST",
          }).then(function (result) {
            if (result.error) {
              alert(result.error.message);
            } else {
              return stripe.redirectToCheckout({ sessionId: session.id });
            }
          });
        });
      }
    });
  </script>
<% end %>

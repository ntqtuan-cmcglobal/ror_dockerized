<header class="bg-white shadow">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    <a href="/" class="text-2xl md:text-3xl font-bold text-blue-600 hover:text-blue-800 transition-colors duration-200">
      Digital Assets Store
    </a>
    <nav class="flex flex-1 items-center justify-between ml-8">
      <!-- Left menu -->
      <ul class="flex space-x-4 items-center">
        <% if user_signed_in? %>
          <li>
            <a href="/" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200">Home</a>
          </li>
          <li>
            <a href="/products" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200">Products</a>
          </li>
          <% if current_user.buyer? %>
            <li>
              <a href="/cart" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200">
                Cart
                <% if current_user.cart&.cart_items&.any? %>
                  <span class="ml-1 inline-block bg-blue-600 text-white text-xs rounded-full px-2 py-0.5">
                    <%= current_user.cart.cart_items.count %>
                  </span>
                <% end %>
              </a>
            </li>
            <li>
              <a href="/orders" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200">
                My Orders
              </a>
            </li>
          <% end %>
          <% if current_user.admin? || current_user.seller? %>
            <li>
              <a href="/categories" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200">Categories</a>
            </li>
          <% end %>
          <% if current_user.seller? %>
            <li>
              <a href="/selling-point" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200">Selling Point</a>
            </li>
          <% end %>
          <% if current_user.admin? %>
            <li class="relative group">
              <a href="#" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200 flex items-center">
                Administration
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>
              <ul class="absolute left-0 w-40 bg-white border border-gray-200 rounded shadow-lg opacity-0 group-hover:opacity-100 group-hover:visible invisible transition-opacity duration-200 z-10 pointer-events-none group-hover:pointer-events-auto"
                style="pointer-events: auto;">
                <li>
                  <a href="/administration/users" class="block px-4 py-2 text-gray-700 hover:bg-blue-50 hover:text-blue-600">Users</a>
                </li>
                <li>
                  <a href="/administration/orders" class="block px-4 py-2 text-gray-700 hover:bg-blue-50 hover:text-blue-600">Orders</a>
                </li>
                <li>
                  <a href="/administration/payments" class="block px-4 py-2 text-gray-700 hover:bg-blue-50 hover:text-blue-600">Payments</a>
                </li>
                <li>
                  <a href="/administration/reviews" class="block px-4 py-2 text-gray-700 hover:bg-blue-50 hover:text-blue-600">Reviews</a>
                </li>
              </ul>
            </li>
          <% end %>
        <% end %>
      </ul>
      <!-- Right user info -->
      <ul class="flex space-x-4 items-center ml-8">
        <% if user_signed_in? %>
          <li>
            <%= link_to '/users/edit', class: "text-gray-600 px-3 py-2 hover:text-blue-600 transition-colors duration-200", title: "Profile" do %>
              Hello, <%=h current_user.full_name %> (<%=h current_user.role.capitalize %>)
            <% end %>
          </li>
          <li>
            <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200" %>
          </li>
        <% else %>
          <li>
            <%= link_to "Login", new_user_session_path, class: "text-gray-700 hover:text-blue-600 px-3 py-2 rounded transition-colors duration-200" %>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
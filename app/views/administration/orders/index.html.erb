<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-blue-600 mb-6">Orders Administration</h1>
  <div class="mb-4 flex flex-col md:flex-row md:items-center md:justify-between">
    <%= search_form_for @q, url: administration_orders_path, method: :get, html: { class: "flex flex-col md:flex-row gap-4 w-full" } do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 flex-1">
        <div>
          <%= f.label :id_eq, "Order ID", class: "block text-sm font-medium text-gray-700" %>
          <%= f.search_field :id_eq, placeholder: "Search by Order ID", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>
        <div>
          <%= f.label :user_full_name_cont, "Buyer Name", class: "block text-sm font-medium text-gray-700" %>
          <%= f.search_field :user_full_name_cont, placeholder: "Search by Buyer Name", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>
        <div>
          <%= f.label :status_eq, "Status", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :status_eq, options_for_select([['All Statuses', ''], ['Pending', 'pending'], ['Paid', 'paid'], ['Shipped', 'shipped'], ['Cancelled', 'cancelled']], params.dig(:q, :status_eq)), {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
        </div>
        <div>
          <%= f.label :created_at_gteq, "From Date", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :created_at_gteq, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>
      </div>
      <div class="flex items-end gap-2">
        <%= f.submit "Search", class: "w-24 px-2 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer text-sm truncate" %>
        <%= link_to "Reset", administration_orders_path, class: "w-20 px-2 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 text-sm truncate text-center" %>
      </div>
    <% end %>
  </div>
  <div class="mb-4 flex justify-start">
    <%= link_to "New", new_administration_order_path, class: "w-20 px-2 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm truncate text-center inline-block" %>
  </div>
  <div class="overflow-x-auto">
    <% if @orders.present? && @orders.any? %>
      <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow">
        <thead>
          <tr>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :id, "Order ID") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :user_full_name, "Buyer Name") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :total_price, "Total Price") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :status, "Status") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :created_at, "Created At") %>
            </th>
            <th class="px-4 py-2 border-b text-left">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 border-b"><%= order.id %></td>
              <td class="px-4 py-2 border-b"><%= order.user&.full_name %></td>
              <td class="px-4 py-2 border-b"><%= number_to_currency(order.total_price) %></td>
              <td class="px-4 py-2 border-b"><%= order.status.titleize %></td>
              <td class="px-4 py-2 border-b"><%= order.created_at.strftime('%Y-%m-%d %H:%M') %></td>
              <td class="px-4 py-2 border-b">
                <div class="flex space-x-1">
                  <%= link_to "Show", administration_order_path(order), class: "w-12 px-1 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 text-xs truncate text-center" %>
                  <%= link_to "Edit", edit_administration_order_path(order), class: "w-12 px-1 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-xs truncate text-center" %>
                  <%= link_to "Del", administration_order_path(order), method: :delete, data: { confirm: "Are you sure?" }, class: "w-12 px-1 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-xs truncate text-center" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded" role="alert">
        <p class="font-bold">No orders found</p>
        <p>Try adjusting your search or filters.</p>
      </div>
    <% end %>
  </div>
  <div class="mt-6">
    <%= paginate @orders, theme: 'tailwind' if defined?(paginate) %>
  </div>
</div>

<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-blue-600 mb-6">Orders Administration</h1>
  <div class="mb-4">
    <%= search_form_for @q, url: administration_orders_path, method: :get, html: { class: "flex flex-wrap gap-4 items-end" } do |f| %>
      <div>
        <%= f.label :id_eq, "Order ID", class: "block text-sm font-bold text-blue-700 mb-1" %>
        <%= f.search_field :id_eq, placeholder: "Order ID", class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
      </div>
      <div>
        <%= f.label :user_full_name_cont, "Buyer Name", class: "block text-sm font-bold text-blue-700 mb-1" %>
        <%= f.search_field :user_full_name_cont, placeholder: "Buyer Name", class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
      </div>
      <div>
        <%= f.label :status_eq, "Status", class: "block text-sm font-bold text-blue-700 mb-1" %>
        <%= f.select :status_eq,
          options_for_select([
            ['All', ''],
            ['Unpaid', 'unpaid'],
            ['Paid', 'paid'],
            ['Completed', 'completed'],
            ['Cancelled', 'cancel']
          ], params.dig(:q, :status_eq)),
          { include_blank: false },
          class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900"
        %>
      </div>
      <div>
        <%= f.label :created_at_gteq, "Created From", class: "block text-sm font-bold text-blue-700 mb-1" %>
        <%= f.date_field :created_at_gteq, class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
      </div>
      <div>
        <%= f.label :created_at_lteq, "Created To", class: "block text-sm font-bold text-blue-700 mb-1" %>
        <%= f.date_field :created_at_lteq, class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
      </div>
      <div>
        <%= f.submit "Filter", class: "bg-blue-600 hover:bg-blue-700 text-white py-2 px-6 rounded shadow-lg font-bold cursor-pointer" %>
        <%= link_to "Reset", administration_orders_path, class: "ml-2 bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 px-6 rounded shadow-lg font-bold text-center" %>
      </div>
    <% end %>
  </div>
  <div class="mb-4 flex justify-start">
    <%= link_to "New", new_administration_order_path, class: "w-20 px-2 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm truncate text-center inline-block" %>
  </div>
  <div class="overflow-x-auto">
    <% if @orders.present? && @orders.any? %>
      <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow">
        <thead>
          <tr>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :id, "Order ID") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :user_full_name, "Buyer Name") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :total_price, "Total Price") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :status, "Status") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :created_at, "Created At") %>
            </th>
            <th class="px-4 py-2 border-b text-left">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 border-b"><%= order.id %></td>
              <td class="px-4 py-2 border-b"><%= order.user&.full_name %></td>
              <td class="px-4 py-2 border-b"><%= number_to_currency(order.total_price) %></td>
              <td class="px-4 py-2 border-b"><%= order.status.titleize %></td>
              <td class="px-4 py-2 border-b"><%= order.created_at.strftime('%Y-%m-%d %H:%M') %></td>
              <td class="px-4 py-2 border-b">
                <div class="flex space-x-1">
                  <%= link_to "Show", administration_order_path(order), class: "w-12 px-1 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 text-xs truncate text-center" %>
                  <%= link_to "Edit", edit_administration_order_path(order), class: "w-12 px-1 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-xs truncate text-center" %>
                  <%= link_to "Del", administration_order_path(order), method: :delete, data: { confirm: "Are you sure?" }, class: "w-12 px-1 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-xs truncate text-center" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded" role="alert">
        <p class="font-bold">No orders found</p>
        <p>Try adjusting your search or filters.</p>
      </div>
    <% end %>
  </div>
  <div class="mt-6">
    <%= paginate @orders, theme: 'tailwind' if defined?(paginate) %>
  </div>
</div>

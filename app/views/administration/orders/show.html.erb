<h1 class="text-3xl font-bold mb-6 text-blue-600">Order Details</h1>
<% if @order %>
  <div class="bg-white shadow rounded p-6 mb-8">
    <p class="mb-2"><span class="font-semibold">Order ID:</span> <%= @order.id %></p>
    <p class="mb-2"><span class="font-semibold">Buyer:</span> <%= link_to @order.user.full_name, administration_user_path(@order.user), class: 'text-blue-700 underline hover:text-blue-900' %></p>
    <p class="mb-2"><span class="font-semibold">Status:</span> <%= @order.status %></p>
    <p class="mb-2"><span class="font-semibold">Total Amount:</span> <%= number_to_currency(@order.total_price) %></p>
    <p class="mb-2"><span class="font-semibold">Placed At:</span> <%= @order.created_at.strftime("%B %d, %Y %H:%M") %></p>
  </div>
  <h2 class="text-2xl font-semibold mb-4 text-blue-500">Order Items</h2>
  <table class="min-w-full bg-white shadow rounded mb-8">
    <thead>
      <tr>
        <th class="px-4 py-2 text-left bg-gray-100">Product</th>
        <th class="px-4 py-2 text-left bg-gray-100">Quantity</th>
        <th class="px-4 py-2 text-left bg-gray-100">Unit Price</th>
        <th class="px-4 py-2 text-left bg-gray-100">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_items.each do |item| %>
        <tr class="border-b">
          <td class="px-4 py-2"><%= link_to item.product.name, product_path(item.product), class: 'text-blue-700 underline hover:text-blue-900' %></td>
          <td class="px-4 py-2"><%= item.quantity %></td>
          <td class="px-4 py-2"><%= number_to_currency(item.price) %></td>
          <td class="px-4 py-2"><%= number_to_currency(item.quantity * item.price) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-red-600">Order not found.</p>
<% end %>
<%= link_to 'Back to Orders', administration_orders_path, class: 'btn btn-secondary inline-block bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded' %>
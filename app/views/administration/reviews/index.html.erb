<h1 class="text-3xl font-bold text-blue-600 mb-6">Reviews</h1>
<!-- Filters Form -->
<div class="mb-6">
  <%= search_form_for @q, url: administration_reviews_path, method: :get, html: { class: "flex flex-wrap gap-4 items-end" } do |f| %>
    <div>
      <label for="q_comment_cont" class="block text-sm font-bold text-blue-700 mb-1">Comment</label>
      <%= f.text_field :comment_cont, value: params.dig(:q, :comment_cont), class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
    </div>
    <div>
      <label for="q_user_full_name_cont" class="block text-sm font-bold text-blue-700 mb-1">Author Full Name</label>
      <%= f.text_field :user_full_name_cont, value: params.dig(:q, :user_full_name_cont), class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
    </div>
    <div>
      <label for="q_product_name_cont" class="block text-sm font-bold text-blue-700 mb-1">Product Name</label>
      <%= f.text_field :product_name_cont, value: params.dig(:q, :product_name_cont), class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
    </div>
    <div>
      <label for="q_rating_eq" class="block text-sm font-bold text-blue-700 mb-1">Rating</label>
      <%= f.number_field :rating_eq, value: params.dig(:q, :rating_eq), min: 1, max: 5, class: "mt-1 block w-24 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
    </div>
    <div>
      <label for="q_created_at_gteq" class="block text-sm font-bold text-blue-700 mb-1">Created From</label>
      <%= f.date_field :created_at_gteq, value: params.dig(:q, :created_at_gteq), class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
    </div>
    <div>
      <label for="q_created_at_lteq" class="block text-sm font-bold text-blue-700 mb-1">Created To</label>
      <%= f.date_field :created_at_lteq, value: params.dig(:q, :created_at_lteq), class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
    </div>
    <div>
      <%= f.submit "Filter", class: "bg-blue-600 hover:bg-blue-700 text-white py-2 px-6 rounded shadow-lg font-bold cursor-pointer" %>
      <%= link_to "Reset", administration_reviews_path, class: "ml-2 bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 px-6 rounded shadow-lg font-bold text-center" %>
    </div>
  <% end %>
</div>
<table class="min-w-full bg-white border border-gray-200 rounded-lg shadow">
  <thead>
    <tr class="bg-gray-100">
      <th class="px-4 py-2 border-b text-left font-medium">ID</th>
      <th class="px-4 py-2 border-b text-left font-medium">Comment</th>
      <th class="px-4 py-2 border-b text-left font-medium">Author</th>
      <th class="px-4 py-2 border-b text-left font-medium">Product Name</th>
      <th class="px-4 py-2 border-b text-left font-medium">Rating</th>
      <th class="px-4 py-2 border-b text-left font-medium">Created At</th>
      <th class="px-4 py-2 border-b"></th>
    </tr>
  </thead>
  <tbody>
    <% @reviews.each do |review| %>
      <tr class="border-t">
        <td class="px-4 py-2 border-b"><%= review.id %></td>
        <td class="px-4 py-2 border-b"><%= truncate(review.comment, length: 64, omission: '...') %></td>
        <td class="px-4 py-2 border-b"><%= review.user.full_name %></td>
        <td class="px-4 py-2 border-b"><%= review.product.name %></td>
        <td class="px-4 py-2 border-b"><%= review.rating %></td>
        <td class="px-4 py-2 border-b"><%= review.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
        <td class="px-4 py-2 border-b">
          <div class="flex gap-2">
            <%= link_to 'Show', administration_review_path(review), class: 'bg-blue-500 hover:bg-blue-600 text-white py-1 px-3 rounded text-sm' %>
            <%= link_to 'Delete', administration_review_path(review), method: :delete, data: { confirm: 'Are you sure?' }, class: 'bg-red-500 hover:bg-red-600 text-white py-1 px-3 rounded text-sm' %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="7" class="px-4 py-2 text-center">
        <%= paginate @reviews, theme: 'tailwind' %>
      </td>
    </tr>
  </tfoot>
</table>

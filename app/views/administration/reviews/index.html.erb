<h1 class="text-3xl font-bold text-blue-600 mb-6">Reviews</h1>
<!-- Filters Form -->
<div class="mb-6">
  <%= search_form_for @q, url: administration_reviews_path, method: :get, html: { class: "flex flex-wrap gap-4 items-end" } do |f| %>
    <div>
      <label for="q_comment_cont" class="block text-sm font-medium text-gray-700">Comment</label>
      <%= f.text_field :comment_cont, value: params.dig(:q, :comment_cont), class: "mt-1 block w-44 border-gray-300 rounded-md shadow-sm" %>
    </div>
    <div>
      <label for="q_user_full_name_cont" class="block text-sm font-medium text-gray-700">Author Full Name</label>
      <%= f.text_field :user_full_name_cont, value: params.dig(:q, :user_full_name_cont), class: "mt-1 block w-36 border-gray-300 rounded-md shadow-sm" %>
    </div>
    <div>
      <label for="q_product_name_cont" class="block text-sm font-medium text-gray-700">Product Name</label>
      <%= f.text_field :product_name_cont, value: params.dig(:q, :product_name_cont), class: "mt-1 block w-36 border-gray-300 rounded-md shadow-sm" %>
    </div>
    <div>
      <label for="q_rating_eq" class="block text-sm font-medium text-gray-700">Rating</label>
      <%= f.number_field :rating_eq, value: params.dig(:q, :rating_eq), min: 1, max: 5, class: "mt-1 block w-10 border-gray-300 rounded-md shadow-sm" %>
    </div>
    <div>
      <label for="q_created_at_gteq" class="block text-sm font-medium text-gray-700">Created From</label>
      <%= f.date_field :created_at_gteq, value: params.dig(:q, :created_at_gteq), class: "mt-1 block w-36 border-gray-300 rounded-md shadow-sm" %>
    </div>
    <div>
      <label for="q_created_at_lteq" class="block text-sm font-medium text-gray-700">Created To</label>
      <%= f.date_field :created_at_lteq, value: params.dig(:q, :created_at_lteq), class: "mt-1 block w-36 border-gray-300 rounded-md shadow-sm" %>
    </div>
    <div>
      <%= f.submit "Filter", class: "bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded cursor-pointer" %>
    </div>
  <% end %>
</div>
<table class="min-w-full bg-white border border-gray-200 rounded-lg shadow">
  <thead>
    <tr class="bg-gray-100">
      <th class="w-16 px-2 py-2 text-left font-medium">ID</th>
      <th class="w-1/3 px-2 py-2 text-left font-medium">Comment</th>
      <th class="w-1/6 px-2 py-2 text-left font-medium">Author</th>
      <th class="w-1/12 px-2 py-2 text-left font-medium">Product Name</th>
      <th class="w-16 px-2 py-2 text-left font-medium">Rating</th>
      <th class="w-48 px-2 py-2 text-left font-medium">Created At</th>
      <th class="w-48 px-2 py-2"></th>
    </tr>
  </thead>
  <tbody>
    <% @reviews.each do |review| %>
      <tr class="border-t">
        <td class="w-16 px-2 py-2"><%= review.id %></td>
        <td class="w-1/3 px-2 py-2"><%= truncate(review.comment, length: 64, omission: '...') %></td>
        <td class="w-1/6 px-2 py-2"><%= review.user.full_name %></td>
        <td class="w-1/12 px-2 py-2"><%= review.product.name %></td>
        <td class="w-16 px-2 py-2"><%= review.rating %></td>
        <td class="w-48 px-2 py-2"><%= review.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
        <td class="w-48 px-2 py-2">
          <%= link_to 'Show', administration_review_path(review), class: 'bg-blue-500 hover:bg-blue-600 text-white py-1 px-3 rounded text-sm' %>
          <%= link_to 'Delete', administration_review_path(review), method: :delete, data: { confirm: 'Are you sure?' }, class: 'bg-red-500 hover:bg-red-600 text-white py-1 px-3 rounded text-sm' %>
        </td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="7" class="px-2 py-2 text-center">
        <%= paginate @reviews, theme: 'tailwind' %>
      </td>
    </tr>
  </tfoot>
</table>

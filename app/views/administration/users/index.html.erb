<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-blue-600 mb-6">Users Administration</h1>
  <div class="mb-4 flex flex-col md:flex-row md:items-center md:justify-between">
    <%= form_with url: administration_users_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-2" do |f| %>
      <div>
        <%= f.label :search, "Search Users", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :search, value: params[:search], placeholder: "Name or Email", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "Search", class: "ml-0 md:ml-2 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" %>
        <%= link_to "Reset", administration_users_path, class: "ml-2 px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" %>
      </div>
    <% end %>
    <div class="mt-4 md:mt-0">
      <%= link_to "New User", new_administration_user_path, class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700" %>
    </div>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow">
      <thead>
        <tr>
          <th class="px-4 py-2 border-b text-left">ID</th>
          <th class="px-4 py-2 border-b text-left">Full Name</th>
          <th class="px-4 py-2 border-b text-left">Email</th>
          <th class="px-4 py-2 border-b text-left">Role</th>
          <th class="px-4 py-2 border-b text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2 border-b"><%= user.id %></td>
            <td class="px-4 py-2 border-b"><%= user.full_name %></td>
            <td class="px-4 py-2 border-b"><%= user.email %></td>
            <td class="px-4 py-2 border-b"><%= user.role %></td>
            <td class="px-4 py-2 border-b">
              <div class="flex space-x-2">
                <%= link_to "Show", administration_user_path(user), class: "px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm" %>
                <%= link_to "Edit", edit_administration_user_path(user), class: "px-2 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-sm" %>
                <%= link_to "Delete", administration_user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-6">
    <%= paginate @users, theme: 'tailwind' if defined?(paginate) %>
  </div>
</div>
<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-blue-600 mb-6">Users Administration</h1>
  <div class="mb-4">
    <%= search_form_for @q, url: administration_users_path, method: :get, html: { class: "flex flex-wrap gap-4 items-end" } do |f| %>
      <div>
        <%= f.label :full_name_cont, "Full Name", class: "block text-sm font-bold text-blue-700 mb-1" %>
        <%= f.search_field :full_name_cont, placeholder: "Full Name", class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
      </div>
      <div>
        <%= f.label :email_cont, "Email", class: "block text-sm font-bold text-blue-700 mb-1" %>
        <%= f.search_field :email_cont, placeholder: "Email", class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" %>
      </div>
      <div>
        <%= f.label :role_eq, "Role", class: "block text-sm font-bold text-blue-700 mb-1" %>
        <%= f.select :role_eq, options_for_select([['All Roles', ''], ['Admin', 'admin'], ['Seller', 'seller'], ['Buyer', 'buyer']], h(params.dig(:q, :role_eq))), {}, { class: "mt-1 block w-52 border-2 border-blue-400 focus:border-blue-600 rounded-md shadow-lg px-3 py-2 bg-blue-50 text-blue-900" } %>
      </div>
      <div>
        <%= f.submit "Filter", class: "bg-blue-600 hover:bg-blue-700 text-white py-2 px-6 rounded shadow-lg font-bold cursor-pointer" %>
        <%= link_to "Reset", administration_users_path, class: "ml-2 bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 px-6 rounded shadow-lg font-bold text-center" %>
      </div>
    <% end %>
  </div>
  <div class="mb-4 flex justify-start">
    <%= link_to "New", new_administration_user_path, class: "w-20 px-2 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm truncate text-center inline-block" %>
  </div>
  <div class="overflow-x-auto">
    <% if @users.present? && @users.any? %>
      <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow">
        <thead>
          <tr>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :id, "ID") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :full_name, "Full Name") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :email, "Email") %>
            </th>
            <th class="px-4 py-2 border-b text-left">
              <%= sort_link(@q, :role, "Role") %>
            </th>
            <th class="px-4 py-2 border-b text-left">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 border-b"><%= h(user.id) %></td>
              <td class="px-4 py-2 border-b"><%= h(user.full_name) %></td>
              <td class="px-4 py-2 border-b"><%= h(user.email) %></td>
              <td class="px-4 py-2 border-b"><%= h(user.role) %></td>
              <td class="px-4 py-2 border-b">
                <div class="flex space-x-1">
                  <%= link_to "Show", administration_user_path(user), class: "w-12 px-1 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 text-xs truncate text-center" %>
                  <%= link_to "Edit", edit_administration_user_path(user), class: "w-12 px-1 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-xs truncate text-center" %>
                  <% if user.role == 'admin' %>
                    <button class="w-12 px-1 py-1 bg-red-300 text-white rounded text-xs cursor-not-allowed truncate text-center" disabled>Del</button>
                  <% else %>
                    <%= link_to "Del", administration_user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "w-12 px-1 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-xs truncate text-center" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded" role="alert">
        <p class="font-bold">No users found</p>
        <p>Try adjusting your search or filters.</p>
      </div>
    <% end %>
  </div>
  <div class="mt-6">
    <%= paginate @users, theme: 'tailwind' if defined?(paginate) %>
  </div>
</div>
<div class="max-w-2xl mx-auto bg-white shadow-md rounded-lg p-8 mt-10">
  <h1 class="text-2xl font-bold mb-6 text-gray-800">User Details</h1>
  <div class="mb-4">
    <label class="block text-gray-600 font-semibold">Full Name:</label>
    <p class="text-gray-900"><%= @user.full_name %></p>
  </div>
  <div class="mb-4">
    <label class="block text-gray-600 font-semibold">Email:</label>
    <p class="text-gray-900"><%= @user.email %></p>
  </div>
  <div class="mb-4">
    <label class="block text-gray-600 font-semibold">Phone:</label>
    <p class="text-gray-900"><%= @user.phone %></p>
  </div>
  <div class="mb-4">
    <label class="block text-gray-600 font-semibold">Role:</label>
    <p class="text-gray-900"><%= @user.role %></p>
  </div>
  <div class="mb-4">
    <label class="block text-gray-600 font-semibold">Created At:</label>
    <p class="text-gray-900"><%= @user.created_at.strftime("%B %d, %Y %H:%M") %></p>
  </div>
  <div class="flex space-x-4 mt-8">
    <%= link_to 'Edit', edit_administration_user_path(@user), class: "bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded" %>
    <%= link_to 'Back', administration_users_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-2 px-4 rounded" %>
    <% if @user.role == 'admin' %>
      <button class="bg-red-300 text-white font-semibold py-2 px-4 rounded cursor-not-allowed" disabled>Delete</button>
    <% else %>
      <%= link_to 'Delete', administration_user_path(@user), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded" %>
    <% end %>
  </div>
</div>